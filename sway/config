set $mod Mod4
set $term foot
set $menu fuzzel

output DP-1     pos 1920 150  res 2560x1440 adaptive_sync on
output DP-2     pos 0    0    res 1920x1080
output HDMI-A-2 pos 0    1080 res 1920x1080

output * bg ~/.config/sway/wallpaper_1440p.png fill

exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway XDG_SESSION_TYPE=wayland XDG_RUNTIME_DIR MOZ_ENABLE_WAYLAND=1 ELECTRON_OZONE_PLATFORM_HINT=auto QT_QPA_PLATFORM=wayland
exec mako
exec waybar
exec ~/.config/waybar/scripts/mic-events.sh
exec ~/.config/sway/scripts/primarymonitorset.sh
exec --no-startup-id easyeffects --gapplication-service

default_border pixel 1
default_floating_border pixel 1

client.focused          #ffffff #ffffff #000000 #ffffff #ffffff
client.unfocused        #444444 #222222 #888888 #444444 #444444
client.focused_inactive #555555 #333333 #888888 #555555 #555555

gaps inner 12
gaps outer 0
smart_gaps off
exec_always swaymsg gaps inner all set 12
exec_always swaymsg gaps outer all set 0

input type:pointer {
    accel_profile flat
    pointer_accel 0
}

input type:keyboard {
    xkb_layout us,ru,ua
    xkb_options grp:win_space_toggle
}

bindsym --to-code $mod+Return exec $term
bindsym --to-code $mod+Shift+q kill
bindsym --to-code $mod+d exec $menu

bindsym --to-code $mod+h focus left
bindsym --to-code $mod+j focus down
bindsym --to-code $mod+k focus up
bindsym --to-code $mod+l focus right
bindsym --to-code $mod+Shift+h move left
bindsym --to-code $mod+Shift+j move down
bindsym --to-code $mod+Shift+k move up
bindsym --to-code $mod+Shift+l move right

bindsym --to-code $mod+b splith
bindsym --to-code $mod+v splitv
bindsym --to-code $mod+f fullscreen
bindsym --to-code $mod+Shift+space floating toggle

mode "resize" {
    bindsym h resize shrink width 10px
    bindsym j resize grow height 10px
    bindsym k resize shrink height 10px
    bindsym l resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

bindsym --to-code $mod+Shift+s exec hyprshot -m region -z --clipboard-only --silent

floating_modifier $mod normal

bindsym --to-code $mod+Shift+c reload

workspace 1 output DP-1
workspace 4 output DP-1
workspace 2 output DP-2
workspace 5 output DP-2
workspace 3 output HDMI-A-2
workspace 6 output HDMI-A-2

bindsym --to-code $mod+1 workspace number 1
bindsym --to-code $mod+2 workspace number 2
bindsym --to-code $mod+3 workspace number 3
bindsym --to-code $mod+4 workspace number 4
bindsym --to-code $mod+5 workspace number 5
bindsym --to-code $mod+6 workspace number 6

bindsym --to-code $mod+Shift+1 move container to workspace number 1
bindsym --to-code $mod+Shift+2 move container to workspace number 2
bindsym --to-code $mod+Shift+3 move container to workspace number 3
bindsym --to-code $mod+Shift+4 move container to workspace number 4
bindsym --to-code $mod+Shift+5 move container to workspace number 5
bindsym --to-code $mod+Shift+6 move container to workspace number 6

bindsym --to-code --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym --to-code --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --to-code --locked XF86AudioMute        exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

include /etc/sway/config.d/*
